{
  "identifier": "default",
  "description": "Default capabilities for Sonora",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "shell:allow-open",
    "allow-get-app-info",
    "allow-get-platform-info",
    "allow-discord-set-activity",
    "allow-discord-clear-activity",
    "allow-ytm-control",
    "allow-ytm-set-signin-visible",
    "allow-ytm-sign-out",
    "allow-ytm-request",
    "allow-set-floating-regions",
    "allow-present-main-window"
  ]
}
