{
  "productName": "Sonora",
  "version": "0.6.8",
  "identifier": "com.sonora.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Sonora",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://lh3.googleusercontent.com https://yt3.googleusercontent.com https://yt3.ggpht.com https://*.ytimg.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://lrclib.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["filters/NOTICE.txt", "filters/BRAVE-LICENSE.txt", "filters/EASYLIST-LICENSE.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
