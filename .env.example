# Sonora does not require any .env file or API key for normal development or builds.
# Copy values into your shell or .env.local only when needed.

# Optional host IP/hostname for remote Vite HMR and Tauri frontend development (vite.config.ts)
# TAURI_DEV_HOST=

# Optional Rust backend log filter used by env_logger (src-tauri/src/lib.rs)
# RUST_LOG=sonora_lib=info
