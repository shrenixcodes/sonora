{
  "name": "sonora",
  "version": "0.8.19",
  "description": "An immersive YouTube Music desktop client for Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "keywords": [
    "music",
    "youtube-music",
    "desktop",
    "tauri"
  ],
  "author": "Shreyan Bag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrenixcodes/sonora.git"
  },
  "homepage": "https://github.com/shrenixcodes/sonora#readme",
  "bugs": {
    "url": "https://github.com/shrenixcodes/sonora/issues"
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@tauri-apps/cli": "^2.12.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
